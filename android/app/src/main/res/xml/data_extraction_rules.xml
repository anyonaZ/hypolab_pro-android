<?xml version="1.0" encoding="utf-8"?>
<!-- Never copy the BRAIN session, saved credentials or API keys to cloud backups or other devices.
     Use Settings > Local data management > Backup database to move research data. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
